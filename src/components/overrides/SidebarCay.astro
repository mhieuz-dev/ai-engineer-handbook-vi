---
// Bản sao có chỉnh của SidebarSublist (Starlight 0.42): thêm nút "Sắp có" và data-slug.
import { Icon } from '@astrojs/starlight/components';
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro';

import type { Nut } from '../../lib/sidebar-cay';

interface Props { sublist: Nut[]; nested?: boolean }
const { sublist, nested } = Astro.props;
const coTrangHienTai = (e: Nut): boolean =>
	e.type === 'link' ? !!e.isCurrent : e.type === 'group' ? e.entries.some(coTrangHienTai) : false;
const slugCua = (href: string) => href.replace(/^\/|\/$/g, '');
---

<ul class:list={{ 'top-level': !nested }}>
	{
		sublist.map((entry) => (
			<li>
				{entry.type === 'link' ? (
					<a
						href={entry.href}
						data-slug={slugCua(entry.href)}
						aria-current={entry.isCurrent ? 'page' : undefined}
						class:list={[{ large: !nested }, entry.attrs?.class]}
					>
						<span>{entry.label}</span>
					</a>
				) : entry.type === 'sap-co' ? (
					<span class="sap-co" aria-disabled="true">
						<span>{entry.label}</span>
						<span class="nhan-sap-co">Sắp có</span>
					</span>
				) : (
					<details open={coTrangHienTai(entry) || !entry.collapsed}>
						<summary>
							<span class="group-label">
								<span class="large">{entry.label}</span>
								{entry.collapsed && entry.sapCo ? <span class="dem-sap-co">· {entry.sapCo} chương sắp có</span> : null}
							</span>
							<Icon name="right-caret" class="caret" size="1.25rem" />
						</summary>
						<SidebarRestorePoint />
						<Astro.self sublist={entry.entries} nested />
					</details>
				)}
			</li>
		))
	}
</ul>

<style>
	@layer starlight.core {
		ul { --sl-sidebar-item-padding-inline: 0.5rem; list-style: none; padding: 0; }
		li { overflow-wrap: anywhere; }
		/* Không kẻ vạch dọc trong thẻ sidebar: thụt lề đủ cho thấy cấp bậc, như bản mẫu. */
		ul ul li { margin-inline-start: 0.65rem; }
		.dem-sap-co { margin-inline-start: 0.4em; font-size: var(--sl-text-xs); font-weight: 400; color: var(--mut-chu); }
		.large { font-size: var(--sl-text-lg); font-weight: 600; color: var(--sl-color-white); }
		.top-level > li + li { margin-top: 0.75rem; }
		summary {
			display: flex; align-items: center; justify-content: space-between;
			padding: 0.2em var(--sl-sidebar-item-padding-inline); line-height: 1.4;
			cursor: pointer; user-select: none;
		}
		summary::marker, summary::-webkit-details-marker { display: none; }
		.caret { transition: transform 0.2s ease-in-out; flex-shrink: 0; }
		[open] > summary .caret { transform: rotateZ(90deg); }
		a {
			display: block; border-radius: 10px; text-decoration: none;
			color: var(--sl-color-gray-2); padding: 0.35em 0.6em; line-height: 1.4;
		}
		a:hover, a:focus { color: var(--sl-color-white); }
		/* Mục đang đọc: viên trắng nổi trên thẻ, chấm nhỏ màu --pri trước tên. */
		[aria-current='page'], [aria-current='page']:hover, [aria-current='page']:focus {
			font-weight: 600; color: var(--pri); background-color: var(--be-mat);
			box-shadow: 0 1px 3px rgb(80 60 30 / 0.1);
		}
		[aria-current='page']::before {
			content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%;
			background: var(--pri); margin-inline-end: 0.55em; vertical-align: 0.15em;
		}
		/* Chương chứa trang đang đọc: tên màu --pri như bản mẫu. */
		details:has(> ul > li > a[aria-current='page']) > summary .large { color: var(--pri); }
		.sap-co {
			display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
			padding: 0.3em var(--sl-sidebar-item-padding-inline); line-height: 1.4;
			color: var(--mut-chu); cursor: default;
		}
		.nhan-sap-co {
			flex-shrink: 0; font-size: var(--sl-text-xs); padding: 0 0.5em; border-radius: 999px;
			border: 1px solid var(--sl-color-hairline); color: var(--mut-chu); background: var(--bg);
		}
		@media (min-width: 50rem) {
			.top-level > li + li { margin-top: 0.5rem; }
			.large { font-size: var(--sl-text-sm); }
			a, .sap-co { font-size: var(--sl-text-sm); }
		}
	}
</style>

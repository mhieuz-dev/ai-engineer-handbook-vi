---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import { NHANH, PHAN, CHUONG } from '../../data/chuong';
import { dungCay, type Nut } from '../../lib/sidebar-cay';
import SidebarCay from './SidebarCay.astro';
import { MENU_CHUNG } from '../../data/menu-chung';
import TienDoSidebar from '../TienDoSidebar.astro';

const cay = dungCay(Astro.locals.starlightRoute.sidebar as Nut[], NHANH, PHAN, CHUONG);
---

<SidebarPersister>
	<SidebarCay sublist={cay} />
</SidebarPersister>

<TienDoSidebar />

<div class="md:sl-hidden">
	<nav class="nav-sidebar" aria-label="Menu chính">
		{MENU_CHUNG.map((m) => <a href={m.href}>{m.nhan}</a>)}
	</nav>
</div>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>

<style>
	.nav-sidebar { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--sl-color-hairline); font-weight: 600; }
	.nav-sidebar a { color: var(--sl-color-text-accent); text-decoration: none; }
</style>

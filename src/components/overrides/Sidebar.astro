---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import { NHANH, PHAN, CHUONG } from '../../data/chuong';
import { dungCay, type Nut } from '../../lib/sidebar-cay';
import SidebarCay from './SidebarCay.astro';

const cay = dungCay(Astro.locals.starlightRoute.sidebar as Nut[], NHANH, PHAN, CHUONG);
---

<SidebarPersister>
	<SidebarCay sublist={cay} />
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>

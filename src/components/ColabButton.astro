---
interface Props {
	notebook: string;
}
import { colabUrl } from '../lib/tai-ve';
const { notebook } = Astro.props;
const href = colabUrl(notebook);
---

<div class="colab-hang">
	<a class="colab-nut" href={href} target="_blank" rel="noopener">▶ Mở trong Colab</a>
	<code class="colab-duong-dan">notebooks/{notebook}</code>
</div>

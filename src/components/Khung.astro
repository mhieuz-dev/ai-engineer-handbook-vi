---
type Loai = 'truc-giac' | 'vi-sao' | 'loi' | 'doc-bieu-do' | 'phong-van' | 'dao-sau';
interface Props {
	loai: Loai;
	tieuDe?: string;
	/** Nhãn viên nhỏ bên phải hàng tiêu đề, chỉ hiện khi tác giả đặt (ví dụ "Trực giác cốt lõi"). */
	nhan?: string;
}
const { loai, tieuDe = '', nhan } = Astro.props;
const tieuDeHien: Record<Loai, string> = {
	'truc-giac': 'TRỰC GIÁC',
	'vi-sao': `VÌ SAO LẠI LÀ ${tieuDe}?`,
	loi: 'LỖI HAY GẶP',
	'doc-bieu-do': 'ĐỌC BIỂU ĐỒ NÀY NHƯ THẾ NÀO',
	'phong-van': 'CÂU HỎI PHỎNG VẤN',
	'dao-sau': `ĐÀO SÂU: ${tieuDe}`,
};
// Biểu tượng nét 24x24: bóng đèn, la bàn, tam giác cảnh báo, biểu đồ, bong bóng chat, các lớp chồng.
const hinh: Record<Loai, string> = {
	'vi-sao': '<path d="M9 18h6M10 22h4"/><path d="M15.1 14c.2-1 .7-1.7 1.4-2.5A4.6 4.6 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.4 2.5"/>',
	'truc-giac': '<circle cx="12" cy="12" r="10"/><path d="m16.2 7.8-2.1 6.3-6.3 2.1 2.1-6.3z"/>',
	loi: '<path d="m21.7 18-8-14a2 2 0 0 0-3.4 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3"/><path d="M12 9v4M12 17h.01"/>',
	'doc-bieu-do': '<path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="m19 9-5 5-4-4-3 3"/>',
	'phong-van': '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z"/>',
	'dao-sau': '<path d="M12.8 2.2a2 2 0 0 0-1.6 0L2.6 6.1a1 1 0 0 0 0 1.8l8.6 3.9a2 2 0 0 0 1.6 0l8.6-3.9a1 1 0 0 0 0-1.8z"/><path d="m2 12.7 9.2 4.1a2 2 0 0 0 1.6 0l9.2-4.1M2 17.7l9.2 4.1a2 2 0 0 0 1.6 0l9.2-4.1"/>',
};
const lop = `khung khung-${loai}`;
const bieuTuong = `<svg class="khung-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${hinh[loai]}</svg>`;
---

{
	loai === 'dao-sau' ? (
		<details class={lop}>
			<summary class="khung-nhan">
				<Fragment set:html={bieuTuong} />
				<span class="khung-tieu-de">{tieuDeHien[loai]}</span>
				{nhan && <span class="khung-tag">{nhan}</span>}
				<svg class="khung-mo" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 3.5 4.5 4.5L6 12.5" /></svg>
			</summary>
			<div class="khung-than"><slot /></div>
		</details>
	) : (
		<aside class={lop}>
			<div class="khung-nhan">
				<Fragment set:html={bieuTuong} />
				<span class="khung-tieu-de">{tieuDeHien[loai]}</span>
				{nhan && <span class="khung-tag">{nhan}</span>}
			</div>
			<div class="khung-than"><slot /></div>
		</aside>
	)
}

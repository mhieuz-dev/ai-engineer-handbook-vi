---
import { getCollection } from 'astro:content';
import { dungLinkNguoc, linkHocKy } from '../lib/thuat-ngu';
import { BANG_CHU_CAI, chuCai, chuanHoaTim } from '../lib/thuat-ngu-muc';
import { PHAN, timChuongTheoSlugTrang } from '../data/chuong';

const docs = await getCollection('docs');
const nguoc = dungLinkNguoc(docs.map((d) => ({ id: d.id, title: d.data.title, body: d.body ?? '' })));
const docIds = docs.map((d) => d.id);
const muc = (await getCollection('thuatNgu')).sort((a, b) => a.data.ten.localeCompare(b.data.ten, 'vi'));

// Phần của mỗi thuật ngữ: lấy chương nhỏ nhất trong các trang dùng nó (hoặc chương học kỹ).
const phanCua = (id: string, hocKy?: string) => {
	const ds = [
		...(nguoc.get(id) ?? []).map((t) => timChuongTheoSlugTrang(t.id)),
		hocKy ? timChuongTheoSlugTrang(hocKy) : undefined,
	]
		.filter((c): c is NonNullable<typeof c> => !!c)
		.sort((a, b) => a.so - b.so);
	return ds[0]?.phan;
};
const phanId = new Map(muc.map((m) => [m.id, phanCua(m.id, m.data.hocKy)]));
const phanCoMuc = PHAN.filter((p) => muc.some((m) => phanId.get(m.id) === p.id));

const nhom = new Map<string, typeof muc>();
for (const m of muc) {
	const c = chuCai(m.data.ten);
	nhom.set(c, [...(nhom.get(c) ?? []), m]);
}
const coChu = new Set(nhom.keys());
---

<div class="tn-loc" data-tn-loc>
	<div class="tn-az" role="group" aria-label="Lọc theo chữ cái">
		<button type="button" class="tn-chu tn-tatca" data-tn-chu="" aria-pressed="true">Tất cả</button>
		{
			BANG_CHU_CAI.map((c) => (
				<button type="button" class="tn-chu" data-tn-chu={c} aria-pressed="false" disabled={!coChu.has(c)}>
					{c}
				</button>
			))
		}
		{coChu.has('#') && (
			<button type="button" class="tn-chu" data-tn-chu="#" aria-pressed="false">
				#
			</button>
		)}
	</div>
	<div class="tn-hang">
		<label class="tn-tim">
			<span class="sr-only">Tìm thuật ngữ</span>
			<input type="search" placeholder="Tìm thuật ngữ, tên tiếng Anh…" data-tn-tim autocomplete="off" />
		</label>
		<label class="tn-phan">
			<span>Phần</span>
			<select data-tn-phan>
				<option value="">Tất cả Phần</option>
				{phanCoMuc.map((p) => <option value={p.id}>{p.ten}</option>)}
			</select>
		</label>
	</div>
	<p class="tn-ket" aria-live="polite">
		Đang hiện <strong data-tn-so>{muc.length}</strong> thuật ngữ
	</p>
</div>

{
	[...BANG_CHU_CAI, '#'].filter((c) => nhom.has(c)).map((c) => (
		<section class="nhom-chu" data-nhom={c}>
			<h2 id={`chu-${c === '#' ? 'khac' : c.toLowerCase()}`} class="chu-de">
				{c}
			</h2>
			<dl class="ds-muc">
				{(nhom.get(c) ?? []).map((m) => {
					const hoc = m.data.hocKy ? linkHocKy(m.data.hocKy, docIds) : undefined;
					const trang = nguoc.get(m.id) ?? [];
					return (
						<div
							class="muc"
							id={m.id}
							data-chu={c}
							data-phan={phanId.get(m.id) ?? ''}
							data-tim={chuanHoaTim(`${m.data.ten} ${m.data.tenTiengAnh ?? ''}`)}
						>
							<dt>
								{m.data.ten}
								{m.data.tenTiengAnh && <span class="en">{m.data.tenTiengAnh}</span>}
							</dt>
							<dd>
								<p>{m.data.giaiThich}</p>
								{hoc && (
									<p class="hoc-ky">
										<a href={hoc.href}>Học kỹ ở Chương {hoc.so} →</a>
									</p>
								)}
								{trang.length > 0 && (
									<p class="xuat-hien">
										Xuất hiện ở:{' '}
										{trang.map((t, i) => (
											<>
												{i > 0 && ', '}
												<a href={`/${t.id}/`}>{t.title}</a>
											</>
										))}
									</p>
								)}
							</dd>
						</div>
					);
				})}
			</dl>
		</section>
	))
}

<p class="tn-trong" data-tn-trong hidden>
	Không tìm thấy thuật ngữ nào. Thử bỏ dấu, gõ ngắn hơn hoặc chọn “Tất cả”.
</p>

<script>
	import { chuanHoaTim } from '../lib/thuat-ngu-muc';

	const goc = document.querySelector<HTMLElement>('[data-tn-loc]');
	if (goc) {
		const mucs = [...document.querySelectorAll<HTMLElement>('.muc[data-chu]')];
		const nhoms = [...document.querySelectorAll<HTMLElement>('.nhom-chu')];
		const nutChu = [...goc.querySelectorAll<HTMLButtonElement>('[data-tn-chu]')];
		const oTim = goc.querySelector<HTMLInputElement>('[data-tn-tim]')!;
		const selPhan = goc.querySelector<HTMLSelectElement>('[data-tn-phan]')!;
		const so = document.querySelector<HTMLElement>('[data-tn-so]')!;
		const trong = document.querySelector<HTMLElement>('[data-tn-trong]')!;
		let chu = '';

		const loc = () => {
			const q = chuanHoaTim(oTim.value);
			const phan = selPhan.value;
			let n = 0;
			for (const m of mucs) {
				const ok = (!chu || m.dataset.chu === chu) && (!phan || m.dataset.phan === phan) && (!q || (m.dataset.tim ?? '').includes(q));
				m.hidden = !ok;
				if (ok) n++;
			}
			for (const s of nhoms) s.hidden = ![...s.querySelectorAll<HTMLElement>('.muc')].some((x) => !x.hidden);
			so.textContent = String(n);
			trong.hidden = n > 0;
		};

		for (const b of nutChu) {
			b.addEventListener('click', () => {
				chu = b.dataset.tnChu ?? '';
				for (const x of nutChu) x.setAttribute('aria-pressed', String(x === b));
				loc();
			});
		}
		oTim.addEventListener('input', loc);
		oTim.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				oTim.value = '';
				loc();
			}
		});
		selPhan.addEventListener('change', loc);

		// Vào bằng #chu-a thì chọn sẵn chữ đó (giữ nguyên cuộn của trình duyệt).
		const m = /^#chu-([a-z]|khac)$/.exec(location.hash);
		if (m) {
			const c = m[1] === 'khac' ? '#' : m[1].toUpperCase();
			const nut = nutChu.find((x) => x.dataset.tnChu === c);
			if (nut) {
				chu = c;
				for (const x of nutChu) x.setAttribute('aria-pressed', String(x === nut));
				loc();
			}
		}
	}
</script>

<style>
	/* Thanh lọc dính dưới thanh điều hướng: A-Z, ô tìm và lọc theo Phần. */
	.tn-loc {
		position: sticky;
		top: var(--sl-nav-height);
		z-index: 5;
		margin: 1rem 0 1.2rem;
		padding: 0.7rem 0.8rem;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: color-mix(in srgb, var(--bg) 92%, transparent);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		box-shadow: var(--bong-1);
	}
	.tn-az {
		display: flex;
		flex-wrap: nowrap;
		gap: 0.15rem;
		overflow-x: auto;
		padding-bottom: 0.35rem;
		scrollbar-width: thin;
	}
	.tn-chu {
		flex: none;
		min-width: 1.45rem;
		height: 1.6rem;
		padding: 0 0.25rem;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: var(--bg);
		color: var(--tx);
		font-family: 'Be Vietnam Pro', system-ui, sans-serif;
		font-size: 0.78rem;
		font-weight: 700;
		cursor: pointer;
	}
	.tn-chu:hover:not(:disabled) {
		border-color: var(--khu-tra);
		color: var(--khu-tra);
	}
	.tn-chu[aria-pressed='true'] {
		background: var(--khu-tra);
		border-color: var(--khu-tra);
		color: var(--bg);
	}
	.tn-chu:disabled {
		opacity: 0.35;
		cursor: default;
	}
	.tn-tatca {
		padding: 0 0.55rem;
	}
	.tn-hang {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
		margin-top: 0.4rem;
	}
	.tn-tim {
		flex: 1 1 12rem;
	}
	.tn-tim input {
		width: 100%;
		padding: 0.4rem 0.6rem;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--bg);
		color: var(--tx);
		font: inherit;
		font-size: 0.86rem;
	}
	.tn-tim input:focus-visible,
	.tn-phan select:focus-visible {
		outline: 2px solid var(--khu-tra);
		outline-offset: 1px;
	}
	.tn-phan {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.78rem;
		color: var(--mut-chu);
	}
	.tn-phan select {
		max-width: 16rem;
		padding: 0.35rem 0.5rem;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--bg);
		color: var(--tx);
		font: inherit;
		font-size: 0.82rem;
	}
	.tn-ket {
		margin: 0.45rem 0 0;
		font-size: 0.76rem;
		color: var(--mut-chu);
	}
	.tn-ket strong {
		color: var(--tx);
		font-variant-numeric: tabular-nums;
	}
	.nhom-chu {
		margin-top: 1.4rem;
	}
	.chu-de {
		margin: 0 0 0.4rem;
		padding-bottom: 0.25rem;
		border-bottom: 2px solid color-mix(in srgb, var(--khu-tra) 35%, var(--line));
		font-family: 'Be Vietnam Pro', system-ui, sans-serif;
		font-size: 1.4rem;
		font-weight: 800;
		color: var(--khu-tra);
		scroll-margin-top: calc(var(--sl-nav-height) + 8rem);
	}
	.ds-muc {
		margin: 0;
	}
	.muc {
		margin: 0 0 1.5rem;
		scroll-margin-top: calc(var(--sl-nav-height) + 8rem);
	}
	.muc[hidden],
	.nhom-chu[hidden],
	.tn-trong[hidden] {
		display: none;
	}
	dt {
		font-family: 'Be Vietnam Pro', sans-serif;
		font-weight: 800;
		font-size: 1.1rem;
		color: var(--tx);
	}
	.en {
		margin-left: 0.5rem;
		padding: 0.05rem 0.5rem;
		border-radius: 999px;
		font-weight: 600;
		font-size: 0.8rem;
		font-style: italic;
		color: var(--acc-chu);
		background: var(--accbg);
	}
	dd {
		margin: 0.25rem 0 0;
	}
	dd p {
		margin: 0.25rem 0;
	}
	.xuat-hien,
	.hoc-ky {
		font-family: 'Be Vietnam Pro', sans-serif;
		font-size: 0.9rem;
	}
	.tn-trong {
		margin: 1.5rem 0;
		padding: 1rem;
		border: 1px dashed var(--line);
		border-radius: 10px;
		color: var(--mut-chu);
		text-align: center;
	}
</style>

---
import { getCollection, getEntry } from 'astro:content';
import { hienTenTiengAnh, linkHocKy } from '../lib/thuat-ngu';
import En from './En.astro';

interface Props {
	id: string;
	/** Một câu riêng cho chương đang dùng thuật ngữ, chỉ hiện trong tooltip (trang /thuat-ngu/ không có). */
	oDay?: string;
	/** false: không hiện tên tiếng Anh cạnh chữ, cho vài chỗ câu văn đã tự nêu tên tiếng Anh. */
	en?: boolean;
}
const { id, oDay, en = true } = Astro.props;
const muc = await getEntry('thuatNgu', id);
if (!muc) throw new Error(`Thuật ngữ chưa khai báo: ${id}`);
const { ten, tenTiengAnh, giaiThich, hocKy } = muc.data;
const chu = await Astro.slots.render('default');
const chuHien = chu.replace(/<[^>]*>/g, '');
const tenEn = en && hienTenTiengAnh(chuHien, tenTiengAnh) ? tenTiengAnh : undefined;
const tipId = `tip-${id}-${Math.random().toString(36).slice(2, 8)}`;
const docIds = hocKy ? (await getCollection('docs')).map((d) => d.id) : [];
const hoc = hocKy ? linkHocKy(hocKy, docIds, Astro.url.pathname) : undefined;
---

<span class="term-wrap"><span class="term" tabindex="0" role="button" aria-expanded="false" aria-describedby={tipId}><Fragment set:html={chu} /></span>{tenEn && <Fragment>{' '}<En class="term-en">{tenEn}</En></Fragment>}<span class="tip" role="tooltip" id={tipId} tabindex="-1"><span class="nhan">NHẮC NHANH · {ten.toUpperCase()}</span><span class="nd">{giaiThich}</span>{oDay && <span class="o-day">{oDay}</span>}{hoc && <a class="hoc-ky" href={hoc.href}>Học kỹ ở Chương {hoc.so} →</a>}<button type="button" class="tip-dong" aria-label="Đóng"><svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></button></span></span>

<style is:global>
	.term-wrap {
		position: relative;
	}
	.term {
		border-bottom: 2px dotted var(--pri);
		cursor: help;
	}
	/* Khung nhắc nhanh như bản mẫu: nền --panel, viền ấm, bo nhỏ, nút × đóng ở góc phải. */
	.term-wrap .tip {
		display: none;
		position: absolute;
		left: 0;
		top: calc(100% + 6px);
		width: 320px;
		max-width: min(320px, 90vw);
		background: var(--panel);
		border: 1px solid color-mix(in srgb, var(--line), var(--mut) 30%);
		box-shadow: 0 10px 28px -8px rgb(80 60 30 / 0.28);
		border-radius: 6px;
		padding: 12px 14px;
		font-family: 'Be Vietnam Pro', sans-serif;
		font-style: normal;
		font-weight: 400;
		font-size: 13px;
		line-height: 1.55;
		text-align: left;
		color: var(--tx);
		cursor: default;
		z-index: 9;
	}
	:root[data-theme='dark'] .term-wrap .tip { box-shadow: 0 10px 28px -8px rgb(0 0 0 / 0.6); }
	.term-wrap[data-open] .tip {
		display: block;
	}
	.term-wrap .tip .nhan {
		display: block;
		color: var(--pri);
		font-weight: 800;
		font-size: 11px;
		letter-spacing: 0.04em;
		margin-bottom: 4px;
		padding-inline-end: 22px;
	}
	.term-wrap .tip .tip-dong {
		position: absolute;
		top: 6px;
		right: 6px;
		display: grid;
		place-items: center;
		width: 26px;
		height: 26px;
		padding: 0;
		border: 0;
		border-radius: 6px;
		background: transparent;
		color: var(--mut-chu);
		cursor: pointer;
	}
	.term-wrap .tip .tip-dong:hover { background: color-mix(in srgb, var(--line) 70%, transparent); color: var(--tx); }
	.term-wrap .tip .tip-dong:focus-visible { outline: 2px solid var(--pri); outline-offset: 1px; }
	.term-wrap .tip .nd,
	.term-wrap .tip .o-day {
		display: block;
	}
	.term-wrap .tip .o-day {
		margin-top: 4px;
	}
	.term-wrap .tip .hoc-ky {
		display: block;
		margin-top: 6px;
		color: var(--pri);
		font-weight: 600;
	}
</style>

<script>
	// Gắn một lần cho mọi .term-wrap trong trang.
	const BIEN = 8;
	function dat(w: HTMLElement, mo: boolean) {
		w.querySelector('.term')?.setAttribute('aria-expanded', String(mo));
		w.toggleAttribute('data-open', mo);
		if (!mo) return;
		const tip = w.querySelector<HTMLElement>('.tip');
		if (!tip) return;
		tip.style.transform = '';
		const r = tip.getBoundingClientRect();
		const rong = document.documentElement.clientWidth;
		let dich = 0;
		if (r.right > rong - BIEN) dich = rong - BIEN - r.right;
		if (r.left + dich < BIEN) dich = BIEN - r.left;
		if (dich) tip.style.transform = `translateX(${dich}px)`;
	}
	const dangMo = (w: HTMLElement) => w.hasAttribute('data-open');
	const moBangRe = new WeakSet<HTMLElement>(); // mở bởi hover/focus: click kế tiếp không đóng lại
	const chamLuc = new WeakMap<HTMLElement, number>();
	const vuaCham = (w: HTMLElement) => performance.now() - (chamLuc.get(w) ?? -1e9) < 500;
	const moTuDong = (w: HTMLElement) => {
		if (!dangMo(w)) moBangRe.add(w);
		dat(w, true);
	};
	document.querySelectorAll<HTMLElement>('.term-wrap').forEach((w) => {
		const nut = w.querySelector<HTMLElement>('.term')!;
		w.addEventListener('pointerenter', (e) => {
			if (e.pointerType === 'mouse') moTuDong(w);
		});
		w.addEventListener('pointerleave', (e) => {
			if (e.pointerType === 'mouse' && !w.contains(document.activeElement)) dat(w, false);
		});
		// Chạm/bút: bật tắt ngay ở pointerdown (click có thể bị chuyển mục tiêu khi trang cuộn), bỏ focus và click theo sau.
		nut.addEventListener('pointerdown', (e) => {
			if (e.pointerType === 'mouse') return;
			chamLuc.set(w, performance.now());
			dat(w, !dangMo(w));
		});
		nut.addEventListener('focus', () => {
			if (!vuaCham(w)) moTuDong(w);
		});
		w.addEventListener('focusout', (e) => {
			if (!w.contains(e.relatedTarget as Node | null)) dat(w, false);
		});
		w.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				nut.focus({ preventScroll: true });
				dat(w, false);
			} else if ((e.key === 'Enter' || e.key === ' ') && e.target === nut) {
				e.preventDefault();
				moBangRe.delete(w);
				dat(w, !dangMo(w));
			}
		});
		// Nút ×: đưa focus về chữ (bàn phím không lạc chỗ) rồi mới đóng, vì focus vào chữ sẽ tự mở tooltip.
		w.querySelector('.tip-dong')?.addEventListener('click', () => {
			nut.focus({ preventScroll: true });
			moBangRe.delete(w);
			dat(w, false);
		});
		nut.addEventListener('click', () => {
			if (vuaCham(w) && !moBangRe.has(w)) return;
			if (moBangRe.delete(w)) return;
			dat(w, !dangMo(w));
		});
	});
	// Chạm ra ngoài: iOS Safari không blur khi chạm phần tử không focus được, nên nghe pointerdown.
	document.addEventListener('pointerdown', (e) => {
		document.querySelectorAll<HTMLElement>('.term-wrap[data-open]').forEach((w) => {
			if (!w.contains(e.target as Node)) dat(w, false);
		});
	});
</script>

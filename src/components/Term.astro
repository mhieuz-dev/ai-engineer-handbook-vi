---
import { getCollection, getEntry } from 'astro:content';
import { linkHocKy } from '../lib/thuat-ngu';

interface Props {
	id: string;
}
const { id } = Astro.props;
const muc = await getEntry('thuatNgu', id);
if (!muc) throw new Error(`Thuật ngữ chưa khai báo: ${id}`);
const { ten, giaiThich, hocKy } = muc.data;
const tipId = `tip-${id}-${Math.random().toString(36).slice(2, 8)}`;
const docIds = hocKy ? (await getCollection('docs')).map((d) => d.id) : [];
const hoc = hocKy ? linkHocKy(hocKy, docIds) : undefined;
---

<span class="term-wrap"><span class="term" tabindex="0" role="button" aria-expanded="false" aria-describedby={tipId}><slot /></span><span class="tip" role="tooltip" id={tipId} tabindex="-1"><span class="nhan">NHẮC NHANH · {ten.toUpperCase()}</span><span class="nd">{giaiThich}</span>{hoc && <a class="hoc-ky" href={hoc.href}>Học kỹ ở Chương {hoc.so} →</a>}</span></span>

<style is:global>
	.term-wrap {
		position: relative;
	}
	.term {
		border-bottom: 2px dotted var(--pri);
		cursor: help;
	}
	.term-wrap .tip {
		display: none;
		position: absolute;
		left: 0;
		top: 100%;
		width: 300px;
		max-width: min(300px, 90vw);
		background: var(--panel);
		border: 1px solid var(--line);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
		border-radius: 10px;
		padding: 12px 14px;
		font-family: 'Be Vietnam Pro', sans-serif;
		font-style: normal;
		font-weight: 400;
		font-size: 13px;
		line-height: 1.55;
		text-align: left;
		color: var(--tx);
		cursor: default;
		z-index: 9;
	}
	.term-wrap[data-open] .tip {
		display: block;
	}
	.term-wrap .tip .nhan {
		display: block;
		color: var(--pri);
		font-weight: 600;
		margin-bottom: 4px;
	}
	.term-wrap .tip .nd {
		display: block;
	}
	.term-wrap .tip .hoc-ky {
		display: block;
		margin-top: 6px;
		color: var(--pri);
		font-weight: 600;
	}
</style>

<script>
	// Gắn một lần cho mọi .term-wrap trong trang.
	const BIEN = 8;
	function dat(w: HTMLElement, mo: boolean) {
		w.querySelector('.term')?.setAttribute('aria-expanded', String(mo));
		w.toggleAttribute('data-open', mo);
		if (!mo) return;
		const tip = w.querySelector<HTMLElement>('.tip');
		if (!tip) return;
		tip.style.transform = '';
		const r = tip.getBoundingClientRect();
		const rong = document.documentElement.clientWidth;
		let dich = 0;
		if (r.right > rong - BIEN) dich = rong - BIEN - r.right;
		if (r.left + dich < BIEN) dich = BIEN - r.left;
		if (dich) tip.style.transform = `translateX(${dich}px)`;
	}
	const dangMo = (w: HTMLElement) => w.hasAttribute('data-open');
	const moBangRe = new WeakSet<HTMLElement>(); // mở bởi hover/focus: click kế tiếp không đóng lại
	const chamLuc = new WeakMap<HTMLElement, number>();
	const vuaCham = (w: HTMLElement) => performance.now() - (chamLuc.get(w) ?? -1e9) < 500;
	const moTuDong = (w: HTMLElement) => {
		if (!dangMo(w)) moBangRe.add(w);
		dat(w, true);
	};
	document.querySelectorAll<HTMLElement>('.term-wrap').forEach((w) => {
		const nut = w.querySelector<HTMLElement>('.term')!;
		w.addEventListener('pointerenter', (e) => {
			if (e.pointerType === 'mouse') moTuDong(w);
		});
		w.addEventListener('pointerleave', (e) => {
			if (e.pointerType === 'mouse' && !w.contains(document.activeElement)) dat(w, false);
		});
		// Chạm/bút: bật tắt ngay ở pointerdown (click có thể bị chuyển mục tiêu khi trang cuộn), bỏ focus và click theo sau.
		nut.addEventListener('pointerdown', (e) => {
			if (e.pointerType === 'mouse') return;
			chamLuc.set(w, performance.now());
			dat(w, !dangMo(w));
		});
		nut.addEventListener('focus', () => {
			if (!vuaCham(w)) moTuDong(w);
		});
		w.addEventListener('focusout', (e) => {
			if (!w.contains(e.relatedTarget as Node | null)) dat(w, false);
		});
		w.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				nut.focus({ preventScroll: true });
				dat(w, false);
			} else if ((e.key === 'Enter' || e.key === ' ') && e.target === nut) {
				e.preventDefault();
				moBangRe.delete(w);
				dat(w, !dangMo(w));
			}
		});
		nut.addEventListener('click', () => {
			if (vuaCham(w) && !moBangRe.has(w)) return;
			if (moBangRe.delete(w)) return;
			dat(w, !dangMo(w));
		});
	});
	// Chạm ra ngoài: iOS Safari không blur khi chạm phần tử không focus được, nên nghe pointerdown.
	document.addEventListener('pointerdown', (e) => {
		document.querySelectorAll<HTMLElement>('.term-wrap[data-open]').forEach((w) => {
			if (!w.contains(e.target as Node)) dat(w, false);
		});
	});
</script>

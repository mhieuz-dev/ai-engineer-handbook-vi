---
interface Props {
	loai: 'pdf' | 'book' | 'notebook';
}
const { loai } = Astro.props;
---

<svg
	class="icon-tai-ve"
	viewBox="0 0 18 18"
	width="14"
	height="14"
	fill="none"
	stroke="currentColor"
	stroke-width="1.4"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{
		loai === 'pdf' && (
			<>
				<path d="M4 1.8h6.2L14 5.6v10.6H4z" />
				<path d="M10.2 1.8v3.8H14" />
				<path d="M6.3 9.2h5.4M6.3 11.6h5.4" />
			</>
		)
	}
	{
		loai === 'book' && (
			<>
				<path d="M2.8 3.2h5a2 2 0 0 1 1.7 1v10.4a2 2 0 0 0-1.7-1H2.8z" />
				<path d="M15.2 3.2h-5a2 2 0 0 0-1.7 1v10.4a2 2 0 0 1 1.7-1h5z" />
			</>
		)
	}
	{
		loai === 'notebook' && (
			<>
				<rect x="4.2" y="1.8" width="10" height="14.4" rx="1.5" />
				<path d="M7 1.8v14.4M10 1.8v14.4M12.4 5.4h1.8M12.4 8.2h1.8" />
			</>
		)
	}
</svg>

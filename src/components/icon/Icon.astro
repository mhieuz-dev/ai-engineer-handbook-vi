---
interface Props {
	ten:
		| 'hoc'
		| 'luyen'
		| 'tra'
		| 'hoso'
		| 'route'
		| 'thi'
		| 'code'
		| 'math'
		| 'interview'
		| 'glossary'
		| 'notebook'
		| 'info'
		| 'home'
		| 'shield'
		| 'chevron'
		| 'play';
	class?: string;
}
const { ten, class: lop } = Astro.props;
---

<svg
	class:list={['icon', lop]}
	viewBox="0 0 20 20"
	width="16"
	height="16"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{ten === 'hoc' && <><path d="M2.8 4.2h5a2.2 2.2 0 0 1 1.7 1v10.4a2.2 2.2 0 0 0-1.7-1H2.8z" /><path d="M17.2 4.2h-5a2.2 2.2 0 0 0-1.7 1v10.4a2.2 2.2 0 0 1 1.7-1h5z" /></>}
	{ten === 'luyen' && <><circle cx="10" cy="10" r="7" /><circle cx="10" cy="10" r="3.2" /><path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2" /></>}
	{ten === 'tra' && <><circle cx="9" cy="9" r="5.5" /><path d="m13.2 13.2 4.3 4.3" /></>}
	{ten === 'hoso' && <><circle cx="10" cy="7" r="3.2" /><path d="M3.8 17c.6-3.4 3-5 6.2-5s5.6 1.6 6.2 5" /></>}
	{ten === 'route' && <><circle cx="5" cy="5" r="2.2" /><circle cx="15" cy="15" r="2.2" /><path d="M7.2 5H11a2 2 0 0 1 0 4H9a2 2 0 0 0 0 4h3.8" /></>}
	{ten === 'thi' && <><rect x="4" y="3" width="12" height="14.5" rx="1.5" /><path d="M7 3V1.8M13 3V1.8M7 8h6M7 11h6M7 14h3" /></>}
	{ten === 'code' && <><path d="M7.2 5.5 2.8 10l4.4 4.5M12.8 5.5 17.2 10l-4.4 4.5" /></>}
	{ten === 'math' && <><path d="M3 14.5 6.2 9l2.6 5.5L12 4l2.4 8H17" /><path d="M3 17h14" /></>}
	{ten === 'interview' && <><rect x="7" y="2.5" width="6" height="10" rx="3" /><path d="M4.2 10.5a5.8 5.8 0 0 0 11.6 0M10 16.3v2.2M7 18.5h6" /></>}
	{ten === 'glossary' && <><path d="M3 3.5h5a2 2 0 0 1 2 2v11a2 2 0 0 0-2-1.2H3z" /><path d="M17 3.5h-5a2 2 0 0 0-2 2v11a2 2 0 0 1 2-1.2h5z" /><path d="M6 8.2 7.2 6l1.2 2.2M6.3 7.7h1.8" /></>}
	{ten === 'notebook' && <><rect x="4.2" y="2" width="10.5" height="16" rx="1.5" /><path d="M7 2v16M10 2v16M12.5 6h1.8M12.5 9h1.8" /></>}
	{ten === 'info' && <><circle cx="10" cy="10" r="7.2" /><path d="M10 9v5M10 6.2v.1" /></>}
	{ten === 'home' && <><path d="M3 9.5 10 3l7 6.5" /><path d="M5 8.5V17h10V8.5M8.2 17v-4.2h3.6V17" /></>}
	{ten === 'shield' && <><path d="M10 2.5 16.5 5v5c0 4-2.8 6.8-6.5 8-3.7-1.2-6.5-4-6.5-8V5z" /><path d="m7.2 10 2 2 3.6-3.8" /></>}
	{ten === 'chevron' && <path d="m5.5 7.5 4.5 4.5 4.5-4.5" />}
	{ten === 'play' && <path d="M7 4.5 15 10l-8 5.5z" />}
</svg>

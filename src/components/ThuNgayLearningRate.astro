---
// Không props. Dữ liệu 4 sinh viên: x = [1,2,3,4], y = [2,4,5,7].
---

<div class="tn-lr" data-tn-lr>
	<span class="tn-nhan">🎚 THỬ NGAY · KÉO LEARNING RATE</span>
	<div class="tn-hang">
		<label>η = <b data-gia-tri>0,050</b>
			<input type="range" min="0.001" max="0.15" step="0.001" value="0.05" data-thanh aria-label="Learning rate η" />
		</label>
	</div>
	<svg viewBox="0 0 400 130" class="tn-hinh" role="img" aria-label="Đường MSE theo 40 bước lặp, thang log" data-hinh></svg>
	<div class="tn-ketqua" role="status" aria-live="polite" data-ketqua></div>
</div>

<script>
	import { chayGD, chanDoan } from '../lib/gradient-descent';

	const X = [1, 2, 3, 4];
	const Y = [2, 4, 5, 7];
	const phay = (v: number) => v.toFixed(3).replace('.', ',');
	const GHI_CHU = {
		day: 'đã chạm đáy 0,05',
		ngan: 'vẫn đang đi, bước chân hơi ngắn',
		nay: 'gần ngưỡng 0,12: bước chân dài, w và b nảy qua nảy lại hai bên đáy nên loss giảm rất chậm',
	};

	function khoiTao(goc: HTMLElement) {
		const thanh = goc.querySelector<HTMLInputElement>('[data-thanh]')!;
		const giaTri = goc.querySelector<HTMLElement>('[data-gia-tri]')!;
		const hinh = goc.querySelector<SVGSVGElement>('[data-hinh]')!;
		const ketQua = goc.querySelector<HTMLElement>('[data-ketqua]')!;

		function ve() {
			const lr = Number(thanh.value);
			giaTri.textContent = phay(lr);
			thanh.setAttribute('aria-valuetext', phay(lr));
			const mse = chayGD(X, Y, lr, 40);
			const lg = (v: number) => Math.log10(Math.max(v, 1e-3));
			const lo = lg(0.03);
			const hi = lg(1e6);
			const diem = mse
				.map((v, i) => `${10 + i * 9.7},${120 - Math.min(1, Math.max(0, (lg(v) - lo) / (hi - lo))) * 110}`)
				.join(' ');
			const kq = chanDoan(lr, mse);
			hinh.innerHTML =
				`<line x1="10" y1="120" x2="400" y2="120" stroke="var(--line)"/>` +
				`<polyline fill="none" stroke="${kq === 'no' ? 'var(--red)' : 'var(--pri)'}" stroke-width="3" points="${diem}"/>` +
				`<text x="395" y="129" text-anchor="end" font-size="11" fill="var(--mut)">bước lặp →</text>` +
				`<text x="12" y="12" font-size="11" fill="var(--mut)">MSE (thang log)</text>`;
			ketQua.innerHTML = kq === 'no'
				? '<b class="tn-no">Phát nổ!</b> Bước chân dài quá ngưỡng 0,12, loss tăng mãi.'
				: `Sau 40 bước, MSE = <b>${phay(mse[39])}</b> (${GHI_CHU[kq]})`;
		}
		thanh.addEventListener('input', ve);
		ve();
	}
	document.querySelectorAll<HTMLElement>('[data-tn-lr]').forEach(khoiTao);
</script>

<style>
	.tn-lr {
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: 12px;
		padding: 16px 18px;
		margin: 20px 0;
		font-family: 'Be Vietnam Pro', sans-serif;
	}
	.tn-nhan {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: var(--pri);
	}
	.tn-hang label {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-top: 10px;
	}
	.tn-hang b {
		display: inline-block;
		min-width: 52px;
	}
	.tn-hang input {
		flex: 1;
		min-width: 0;
		accent-color: var(--pri);
	}
	.tn-hinh {
		width: 100%;
		height: 150px;
		margin-top: 8px;
	}
	.tn-ketqua {
		font-size: 14px;
		color: var(--mut);
	}
	.tn-lr :global(.tn-no) {
		color: var(--red);
	}
	@media print {
		.tn-lr {
			display: none;
		}
	}
</style>

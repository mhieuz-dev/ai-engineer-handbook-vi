---
import type { Chuong } from '../data/chuong';
import { luaChonTaiVe } from '../lib/tai-ve';

const { chuong } = Astro.props as { chuong: Chuong };
const ds = luaChonTaiVe(chuong);
---

<div class="nut-tai-ve">
	<button type="button" class="ntv-nut" aria-haspopup="menu" aria-expanded="false" aria-controls="ntv-menu">⬇ Tải về</button>
	<div class="ntv-menu" id="ntv-menu" role="menu" hidden>
		{ds.map((m) => (
			<a role="menuitem" href={m.href} target={m.target} rel={m.target ? 'noopener' : undefined} data-in-trang={m.loai === 'in' ? '' : undefined}>{m.nhan}</a>
		))}
	</div>
</div>

<script>
	const goc = document.querySelector<HTMLElement>('.nut-tai-ve');
	if (goc) {
		const nut = goc.querySelector<HTMLButtonElement>('.ntv-nut')!;
		const menu = goc.querySelector<HTMLElement>('.ntv-menu')!;
		const dat = (mo: boolean) => {
			menu.hidden = !mo;
			nut.setAttribute('aria-expanded', String(mo));
		};
		nut.addEventListener('click', () => dat(menu.hidden));
		document.addEventListener('click', (e) => {
			if (!menu.hidden && !goc.contains(e.target as Node)) dat(false);
		});
		goc.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !menu.hidden) {
				dat(false);
				nut.focus();
			}
		});
		menu.addEventListener('click', () => dat(false));
	}
	// Mục "Trang này (PDF)" ở cả menu lẫn cột phải.
	document.addEventListener('click', (e) => {
		const a = (e.target as Element).closest('[data-in-trang]');
		if (a) {
			e.preventDefault();
			window.print();
		}
	});
</script>

<style>
	.nut-tai-ve {
		position: relative;
		font-family: 'Be Vietnam Pro', system-ui, sans-serif;
	}
	.ntv-nut {
		font: inherit;
		font-size: 0.8rem;
		padding: 0.25rem 0.7rem;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: transparent;
		color: var(--pri);
		cursor: pointer;
	}
	.ntv-nut:hover, .ntv-nut[aria-expanded='true'] { background: var(--panel); }
	.ntv-menu {
		position: absolute;
		z-index: 20;
		top: calc(100% + 4px);
		left: 0;
		min-width: 12rem;
		max-width: calc(100vw - 2rem);
		padding: 0.25rem;
		background: var(--panel);
		border: 1px solid var(--line);
		border-radius: 8px;
		box-shadow: 0 4px 14px rgb(0 0 0 / 0.12);
	}
	.ntv-menu[hidden] { display: none; }
	/* Màn hình hẹp: menu nằm trong luồng, không che tiêu đề bên dưới */
	@media (max-width: 820px) {
		.nut-tai-ve { display: flex; flex-direction: column; align-items: flex-start; }
		.ntv-menu { position: static; margin-top: 4px; box-shadow: none; }
	}
	.ntv-menu a {
		display: block;
		padding: 0.45rem 0.7rem;
		border-radius: 6px;
		font-size: 0.85rem;
		color: var(--tx);
		text-decoration: none;
	}
	.ntv-menu a:hover, .ntv-menu a:focus-visible { background: var(--accbg); }
</style>

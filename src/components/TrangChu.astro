---
import { getCollection } from 'astro:content';
import { CHUONG, chuongDaXuatBan } from '../data/chuong';
import { trangBatDauHoc } from '../lib/trang-dau';
import { taiBaiThuatToan } from '../lib/thuat-toan';
import { taiBaiToan } from '../lib/toan';
import { taiPreset } from '../lib/phong-van';
import KeSach from './KeSach.astro';
import LoTrinhPhan from './LoTrinhPhan.astro';
import Icon from './icon/Icon.astro';

const tong = CHUONG.length;
const daViet = chuongDaXuatBan().length;
const ptTong = Math.round((daViet / tong) * 100);
const batDau = (await trangBatDauHoc()) ?? '/ai-engineer/ch00-lo-trinh-va-colab/01-lo-trinh/';
const soThuatToan = (await taiBaiThuatToan()).length;
const soToan = (await taiBaiToan()).length;
const soPhongVan = (await taiPreset()).length;
const soThuatNgu = (await getCollection('thuatNgu')).length;
const soNotebook = chuongDaXuatBan().filter((c) => c.notebook).length;

const buoc = ['Trực giác', 'Toán', 'Tính tay', 'Code', 'Đọc kết quả'];
const tinhNang = [
	['Nhắc nhanh', 'Thuật ngữ mới được giải thích ngay chỗ gặp.'],
	['Thử ngay', 'Kéo thanh trượt, thấy kết quả đổi tại chỗ.'],
	['Tự kiểm tra', 'Câu hỏi ngắn cuối bài, có đáp án.'],
	['Đã đọc', 'Đánh dấu trang đã học, tiến độ lưu trong trình duyệt.'],
	['Tải về PDF', 'In từng trang hoặc cả chương để đọc ngoại tuyến.'],
	['Colab', 'Mở notebook chạy thẳng trên trình duyệt, không cần cài.'],
];

const dsChuong = chuongDaXuatBan().map((c) => ({ slug: c.slug, so: c.so, ten: c.ten }));
---

<div class="trang-chu">
	<section class="hero">
		<p class="hero-dan">
			Mỗi chương đi qua năm bước từ trực giác đến code. Không cần đăng nhập, không thu phí.
		</p>
		<div class="hero-nut">
			<a class="nut-chinh" href={batDau}>Bắt đầu từ Chương 0</a>
			<a class="nut-phu" href="#cac-phan-ten">Xem lộ trình</a>
		</div>

		<div class="tien-do-tong">
			<div class="tdt-hang">
				<strong>{daViet}/{tong} chương</strong>
				<span>đã viết</span>
			</div>
			<div
				class="tdt-thanh"
				role="progressbar"
				aria-label="Số chương đã viết trên tổng số chương"
				aria-valuemin="0"
				aria-valuemax="100"
				aria-valuenow={ptTong}
			>
				<div class="tdt-day" style={`width:${ptTong}%`}></div>
			</div>
		</div>
	</section>

	<aside class="hoc-tiep" data-chuong={JSON.stringify(dsChuong)} hidden>
		<div class="ht-chu">
			<p class="ht-nhan">HỌC TIẾP</p>
			<p class="ht-ten"></p>
			<p class="ht-phu"><span class="ht-pt"></span></p>
		</div>
		<a class="ht-nut" href="/">Đọc tiếp →</a>
	</aside>

	<aside class="hoc-tiep on-lai" data-on-lai hidden>
		<div class="ht-chu">
			<p class="ht-nhan">ÔN LẠI</p>
			<p class="ht-ten"></p>
			<p class="ht-phu"></p>
		</div>
		<a class="ht-nut" href="/phong-thi/" data-on-lai-nut>Thi lại →</a>
	</aside>

	<section class="loi-vao" aria-labelledby="loi-vao-ten">
		<h2 id="loi-vao-ten">Ba lối vào</h2>
		<div class="lv-luoi">
			<article class="lv-the lv-hoc">
				<p class="lv-nhan"><Icon ten="hoc" /> Học</p>
				<h3>Giáo trình AI Engineer</h3>
				<p>{daViet}/{tong} chương, mỗi chương năm bước: trực giác, toán, tính tay, code, đọc kết quả.</p>
				<ul class="lv-ds">
					<li><a href="/lo-trinh/">Lộ trình 65 chương <small>{daViet}/{tong}</small></a></li>
					<li><a href={batDau}>Bắt đầu từ Chương 0</a></li>
					<li><a href="/notebook/">Notebook Colab <small>{soNotebook}</small></a></li>
				</ul>
				<a class="lv-vao" href="/lo-trinh/">Vào khu Học →</a>
			</article>

			<article class="lv-the lv-luyen">
				<p class="lv-nhan"><Icon ten="luyen" /> Luyện tập</p>
				<h3>Thi thử và luyện tay</h3>
				<p>Phòng thi chấm ngay trên máy, {soThuatToan} bài thuật toán, {soToan} bài toán nền, {soPhongVan} phong cách phỏng vấn.</p>
				<ul class="lv-ds">
					<li><a href="/phong-thi/">Phòng thi thử <small>Ch0–Ch7</small></a></li>
					<li><a href="/thuat-toan/">Luyện thuật toán <small>{soThuatToan} bài</small></a></li>
					<li><a href="/toan-thuat-toan/">Toán cho thuật toán <small>{soToan} bài</small></a></li>
				</ul>
				<a class="lv-vao" href="/luyen-tap/">Vào khu Luyện tập →</a>
			</article>

			<article class="lv-the lv-tra">
				<p class="lv-nhan"><Icon ten="tra" /> Tra cứu</p>
				<h3>Từ điển và notebook</h3>
				<p>{soThuatNgu} thuật ngữ giải thích theo ngữ cảnh, {soNotebook} notebook chạy được trên Colab.</p>
				<ul class="lv-ds">
					<li><a href="/thuat-ngu/">Thuật ngữ <small>{soThuatNgu}</small></a></li>
					<li><a href="/notebook/">Notebook <small>{soNotebook}</small></a></li>
					<li><a href="/gioi-thieu/">Giới thiệu <small>Về site</small></a></li>
				</ul>
				<a class="lv-vao" href="/thuat-ngu/">Vào khu Tra cứu →</a>
			</article>
		</div>
	</section>

	<div class="ke-sach-wrap">
		<KeSach />
	</div>

	<LoTrinhPhan />

	<section class="cach-hoc">
		<h2>Cách học trên trang này</h2>
		<p>Mỗi chương đi qua năm bước, từ dễ đến khó.</p>
		<ol class="buoc">
			{buoc.map((b) => <li>{b}</li>)}
		</ol>
		<dl class="tinh-nang">
			{tinhNang.map(([ten, mo]) => (<div><dt>{ten}</dt><dd>{mo}</dd></div>))}
		</dl>
	</section>
</div>

<script is:inline>
	if (window.matchMedia('(max-width: 50rem)').matches) {
		document.querySelectorAll('details.the-phan').forEach(function (d) {
			d.open = false;
		});
	}
</script>

<script>
	import { KHOA_STORAGE, docTuStorage } from '../lib/tien-do';

	const khoi = document.querySelector<HTMLElement>('.hoc-tiep');
	if (khoi) {
		const ds: { slug: string; so: number; ten: string }[] = JSON.parse(khoi.dataset.chuong ?? '[]');
		let kho: Storage | undefined;
		try {
			kho = window.localStorage;
			kho.getItem(KHOA_STORAGE);
		} catch {
			kho = undefined;
		}
		if (kho) {
			const td = docTuStorage(kho);
			const keys = Object.keys(td.daDoc);
			if (keys.length) {
				let moiNhat = keys[0];
				for (const k of keys) if (td.daDoc[k] >= td.daDoc[moiNhat]) moiNhat = k;
				const c = ds.find((x) => moiNhat === x.slug || moiNhat.startsWith(`${x.slug}/`));
				if (c) {
					const duoi = moiNhat.slice(c.slug.length + 1);
					const soTrang = /^(\d+)/.exec(duoi)?.[1];
					khoi.querySelector('.ht-ten')!.textContent = `Chương ${c.so}: ${c.ten}`;
					const docChuong = ds.filter((x) => keys.some((k) => k === x.slug || k.startsWith(`${x.slug}/`))).length;
					const pt = Math.round((docChuong / ds.length) * 100);
					khoi.querySelector('.ht-phu')!.textContent = `${soTrang ? `Trang ${Number(soTrang)} · ` : ''}${pt}% giáo trình`;
					const nut = khoi.querySelector<HTMLAnchorElement>('.ht-nut')!;
					nut.href = `/${moiNhat}/`;
					khoi.hidden = false;
				}
			}
		}
	}

	const khoiOn = document.querySelector<HTMLElement>('.on-lai');
	if (khoiOn) {
		try {
			const ds = JSON.parse(localStorage.getItem('air-bai-thi-v1') ?? '[]');
			const gan = Array.isArray(ds) ? ds[0] : null;
			if (gan?.banDo?.length) {
				const yeu = (gan.banDo as { ten: string; phanTram: number; trang: string }[])
					.filter((x) => x.phanTram < 80)
					.sort((a, b) => a.phanTram - b.phanTram);
				const dau = yeu[0] ?? (gan.banDo[0] as { ten: string; phanTram: number; trang: string });
				const ngay = typeof gan.ngay === 'string' ? new Date(gan.ngay).toLocaleDateString('vi-VN') : '';
				khoiOn.querySelector('.ht-ten')!.textContent = `${dau.ten} (${dau.phanTram}%)`;
				khoiOn.querySelector('.ht-phu')!.textContent = yeu.length > 1
					? `Còn yếu: ${yeu.slice(1, 4).map((x) => `${x.ten} (${x.phanTram}%)`).join(' · ')}`
					: `Từ bài thi ${ngay} · ${gan.diem}/10`;
				const a = khoiOn.querySelector<HTMLAnchorElement>('[data-on-lai-nut]')!;
				if (dau.trang) {
					a.href = dau.trang;
					a.textContent = 'Ôn trang này →';
				}
				khoiOn.hidden = false;
			}
		} catch {
			/* dữ liệu hỏng: bỏ qua */
		}
	}
</script>

<style>
	.trang-chu { max-width: 56rem; margin: 0 auto; font-family: 'Be Vietnam Pro', system-ui, sans-serif; }
	.hero { text-align: center; padding: 0.5rem 0 1rem; }
	/* h1 do Starlight sinh ra từ title của trang; chỉ tạo kiểu cho nó ở trang chủ. */
	:global(main h1#_top) { font-size: clamp(1.7rem, 4.6vw, 2.7rem); font-weight: 800; color: var(--pri); text-align: center; line-height: 1.15; margin: 1.5rem auto 0; max-width: 36rem; }
	.hero-dan { max-width: 38rem; margin: 0.7rem auto 0; font-size: 1rem; line-height: 1.55; color: var(--mut-chu); }
	.hero-nut { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; margin-top: 1rem; }
	.nut-chinh, .nut-phu { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 1.4rem; border-radius: 8px; font-weight: 700; text-decoration: none; }
	.nut-chinh { background: var(--acc); color: #1a1208; border: 1px solid transparent; }
	.nut-chinh:hover { filter: brightness(1.08); }
	.nut-phu { background: var(--bg); color: var(--pri); border: 1px solid var(--line); }
	.nut-phu:hover { border-color: var(--pri); }
	@media (prefers-reduced-motion: no-preference) { :global(html) { scroll-behavior: smooth; } }

	.tien-do-tong { max-width: 32rem; margin: 1.2rem auto 0; }
	.tdt-hang { display: flex; justify-content: space-between; align-items: baseline; font-size: 0.85rem; color: var(--mut-chu); }
	.tdt-hang strong { font-variant-numeric: tabular-nums; color: var(--tx); }
	.tdt-thanh { margin-top: 0.35rem; height: 7px; border-radius: 4px; background: color-mix(in srgb, var(--mut) 25%, transparent); overflow: hidden; }
	.tdt-day { height: 100%; background: linear-gradient(90deg, var(--pri), var(--acc)); }

	.hoc-tiep { display: flex; align-items: center; justify-content: space-between; gap: 1rem; max-width: 32rem; margin: 1.1rem auto 0; padding: 0.8rem 1rem; border: 1px solid var(--line); border-left: 4px solid var(--ok); border-radius: 12px; background: var(--panel); text-align: left; }
	.hoc-tiep[hidden] { display: none; }
	.ht-nhan { margin: 0; font-size: 0.68rem; letter-spacing: 0.09em; font-weight: 700; color: var(--ok-chu); }
	.ht-ten { margin: 0.15rem 0 0; font-weight: 700; color: var(--tx); }
	.ht-phu { margin: 0.1rem 0 0; font-size: 0.78rem; color: var(--mut-chu); }
	.ht-nut { flex: none; font-weight: 700; color: var(--pri); text-decoration: none; white-space: nowrap; }
	.ht-nut:hover { text-decoration: underline; }
	.on-lai { border-left-color: var(--acc); }
	.on-lai .ht-nhan { color: var(--acc-chu); }

	/* Ba lối vào: mỗi khu một màu, ba lối tắt và một lối vào cả khu. */
	.loi-vao h2 { border: 0; margin-top: 2.4rem; }
	.lv-luoi { display: grid; grid-template-columns: 1fr; gap: 0.8rem; }
	@media (min-width: 50rem) { .lv-luoi { grid-template-columns: repeat(3, 1fr); } }
	.lv-the { display: flex; flex-direction: column; gap: 0.45rem; padding: 1rem 1.05rem; border: 1px solid var(--line); border-top: 3px solid var(--khu-lv); border-radius: 14px; background: var(--bg); }
	.lv-hoc { --khu-lv: var(--khu-hoc); }
	.lv-luyen { --khu-lv: var(--khu-luyen); }
	.lv-tra { --khu-lv: var(--khu-tra); }
	.lv-nhan { display: flex; align-items: center; gap: 0.35rem; margin: 0; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--khu-lv); }
	.lv-the h3 { margin: 0; font-size: 1.05rem; font-weight: 800; line-height: 1.3; }
	.lv-the > p:not(.lv-nhan) { margin: 0; font-size: 0.85rem; line-height: 1.5; color: var(--mut-chu); }
	.lv-ds { display: flex; flex-direction: column; gap: 0.1rem; margin: 0.2rem 0 0.4rem; padding: 0; list-style: none; }
	.lv-ds a { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; padding: 0.3rem 0.1rem; border-bottom: 1px dashed color-mix(in srgb, var(--line) 80%, var(--mut)); color: var(--tx); font-size: 0.86rem; text-decoration: none; }
	.lv-ds a:hover { color: var(--khu-lv); }
	.lv-ds small { flex: none; font-size: 0.72rem; color: var(--mut-chu); white-space: nowrap; }
	.lv-vao { margin-top: auto; font-size: 0.84rem; font-weight: 700; color: var(--khu-lv); text-decoration: none; }
	.lv-vao:hover { text-decoration: underline; }

	.ke-sach-wrap { max-width: 40rem; margin: 0 auto; }

	.cach-hoc h2 { border: 0; margin-top: 2.4rem; }
	.buoc { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 1rem 0; counter-reset: b; }
	.buoc li { counter-increment: b; margin: 0; padding: 0.35rem 0.9rem; border-radius: 999px; background: var(--accbg); font-weight: 600; }
	.buoc li::before { content: counter(b) '. '; color: var(--acc); }
	.tinh-nang { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 0.8rem; margin: 1.5rem 0; }
	.tinh-nang div { margin: 0; padding: 0.7rem 0.9rem; border-left: 3px solid var(--pri); background: var(--panel); }
	.tinh-nang dt { font-weight: 600; margin: 0; }
	.tinh-nang dd { margin: 0.15rem 0 0; color: var(--mut); font-size: 0.92rem; }

	@media (max-width: 30rem) {
		.hoc-tiep { align-items: flex-start; }
	}
</style>

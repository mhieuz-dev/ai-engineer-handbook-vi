---
import { taiBaiThuatToan } from '../lib/thuat-toan';
import { DANG } from '../lib/thuat-toan-dang';

const bai = await taiBaiThuatToan();
const jsonBai = JSON.stringify(bai).replace(/</g, '\\u003c');
const jsonDang = JSON.stringify(DANG).replace(/</g, '\\u003c');
---

<div class="tt" data-tt>
	<script type="application/json" id="tt-bai" set:html={jsonBai}></script>
	<script type="application/json" id="tt-dang" set:html={jsonDang}></script>

	<section class="tt-ds" data-tt-ds>
		<div class="tt-tong" data-tt-tong></div>
		<div data-tt-nhom></div>
	</section>
	<section class="tt-noi" data-tt-noi hidden></section>
</div>

<script>
	import { DANG, LO_TRINH, THU_TU_DANG, type BaiThuatToan } from '../lib/thuat-toan-dang';
	import { MayChay } from '../lib/khung-code/chay';
	import { thanhHtml } from '../lib/khung-code/markdown';
	import { hoiTroLy } from '../lib/khung-code/tro-ly';
	import { chuoiNgay, ngayDiaPhuong } from '../lib/tien-do';

	const goc = document.querySelector<HTMLElement>('[data-tt]');
	if (goc) {
		const $ = <T extends HTMLElement>(s: string) => goc.querySelector<T>(s)!;
		const BAI: BaiThuatToan[] = JSON.parse(document.getElementById('tt-bai')!.textContent ?? '[]');
		const elDs = $<HTMLElement>('[data-tt-ds]');
		const elTong = $<HTMLElement>('[data-tt-tong]');
		const elNhom = goc.querySelector<HTMLElement>('[data-tt-nhom]')!;
		const elNoi = $<HTMLElement>('[data-tt-noi]');
		const KHOA = 'air-thuat-toan-v1';
		const KHOA_NHAP = 'air-tt-nhap-v1';

		interface TienDoTT {
			daGiai: Record<string, string>;
			daThu: Record<string, number>;
			ngay: string[];
		}
		const docTT = (): TienDoTT => {
			try {
				const o = JSON.parse(localStorage.getItem(KHOA) ?? '{}');
				return {
					daGiai: o && typeof o.daGiai === 'object' && o.daGiai ? o.daGiai : {},
					daThu: o && typeof o.daThu === 'object' && o.daThu ? o.daThu : {},
					ngay: Array.isArray(o?.ngay) ? o.ngay.filter((x: unknown) => typeof x === 'string') : [],
				};
			} catch {
				return { daGiai: {}, daThu: {}, ngay: [] };
			}
		};
		const ghiTT = (tt: TienDoTT) => {
			try {
				localStorage.setItem(KHOA, JSON.stringify(tt));
			} catch {
				/* bỏ qua */
			}
			window.dispatchEvent(new CustomEvent('du-lieu-doi'));
		};
		const docNhap = (): Record<string, string> => {
			try {
				const o = JSON.parse(localStorage.getItem(KHOA_NHAP) ?? '{}');
				return o && typeof o === 'object' && !Array.isArray(o) ? o : {};
			} catch {
				return {};
			}
		};
		const luuNhap = (so: number, ma: string) => {
			const o = docNhap();
			o[String(so)] = ma;
			try {
				localStorage.setItem(KHOA_NHAP, JSON.stringify(o));
			} catch {
				/* bỏ qua */
			}
		};

		const esc = (s: unknown) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
		const nhanMuc = (m: string) => (m === 'de' ? 'Dễ' : m === 'kho' ? 'Khó' : 'Vừa');

		let cheDo: 'dang' | 'lo-trinh' = 'dang';
		const thuTuMuc: Record<string, number> = { de: 0, vua: 1, kho: 2 };
		const theBai = (b: BaiThuatToan, tt: TienDoTT, buoc?: number) =>
			`<button class="tt-the ${tt.daGiai[b.so] ? 'da-giai' : ''}" type="button" data-tt-mo="${b.so}">
				${buoc ? `<span class="tt-buoc">Bước ${buoc}</span>` : ''}
				<span class="tt-so">${String(b.so).padStart(2, '0')}</span>
				<span class="tt-ten">${esc(b.ten)}</span>
				<span class="tt-muc tt-m-${b.muc}">${nhanMuc(b.muc)}</span>
				${tt.daGiai[b.so] ? '<span class="tt-xong" aria-label="đã giải">✓</span>' : ''}
			</button>`;
		const veDanhSach = () => {
			const tt = docTT();
			const homNay = ngayDiaPhuong(new Date());
			const chuoi = chuoiNgay({ daDoc: {}, ngayHoc: tt.ngay }, homNay);
			elTong.innerHTML = `<p class="tt-tong-chu"><strong>${Object.keys(tt.daGiai).length}/${BAI.length}</strong> bài đã giải<span> · ${chuoi} ngày liên tiếp</span></p>
				<p class="tt-tong-mo">Lộ trình từ dễ đến khó, kết thúc bằng đồ án tổng hợp. Chạy ví dụ để thử, Nộp để chấm test ẩn (có bài lớn bắt lời giải chậm).</p>
				<div class="tt-che-do" role="tablist" aria-label="Cách xem danh sách">
					<button type="button" role="tab" data-tt-cd="dang" aria-selected="${cheDo === 'dang'}" class="${cheDo === 'dang' ? 'dang-chon' : ''}">Theo dạng</button>
					<button type="button" role="tab" data-tt-cd="lo-trinh" aria-selected="${cheDo === 'lo-trinh'}" class="${cheDo === 'lo-trinh' ? 'dang-chon' : ''}">Từ dễ đến khó</button>
				</div>`;
			if (cheDo === 'dang') {
				elNhom.innerHTML = THU_TU_DANG.map((dang) => {
					const ds = BAI.filter((b) => b.dang === dang).sort((a, b) => (thuTuMuc[a.muc] - thuTuMuc[b.muc]) || (a.so - b.so));
					if (!ds.length) return '';
					const da = ds.filter((b) => tt.daGiai[b.so]).length;
					return `<section class="tt-nhom"><h3>${esc(DANG[dang])} <span>${da}/${ds.length}</span></h3>
						<div class="tt-luoi">${ds.map((b) => theBai(b, tt)).join('')}</div></section>`;
				}).join('');
			} else {
				const ds = LO_TRINH.map((so) => BAI.find((b) => b.so === so)).filter((b): b is BaiThuatToan => !!b);
				const da = ds.filter((b) => tt.daGiai[b.so]).length;
				elNhom.innerHTML = `<section class="tt-nhom"><h3>Lộ trình từ dễ đến khó <span>${da}/${ds.length}</span></h3>
					<p class="tt-lo-trinh-mo">Đi theo thứ tự; bài sau dùng lại kỹ năng của bài trước. Bài 41 là đồ án tốt nghiệp tổng hợp 8 dạng.</p>
					<div class="tt-luoi">${ds.map((b, i) => theBai(b, tt, i + 1)).join('')}</div></section>`;
			}
		};

		let may: MayChay | null = null;
		const chayCode = async (ma: string, test: string): Promise<{ dat: boolean; out: string; loi: string }> => {
			if (!may) may = new MayChay();
			await may.nap();
			let out = '';
			let loi = '';
			const chay = may.chay([ma, test], (m) => {
				if (m.loai === 'stdout' || m.loai === 'stderr') out += m.s ?? '';
				else if (m.loai === 'loi') loi = m.message ?? '';
			});
			let het = false;
			const dongHo = window.setTimeout(() => {
				het = true;
				may?.huy();
				loi = 'Quá 45 giây. Lời giải có thể chậm hơn yêu cầu; kiểm tra vòng lặp hoặc độ phức tạp.';
			}, 45000);
			await Promise.race([chay, new Promise<void>((xong) => window.setTimeout(xong, 46000))]);
			window.clearTimeout(dongHo);
			if (het) return { dat: false, out, loi };
			return { dat: !loi && out.includes('OK'), out, loi };
		};

		const moBai = (so: number) => {
			const b = BAI.find((x) => x.so === so);
			if (!b) return;
			const nhap = docNhap()[String(so)] ?? b.khung;
			elDs.hidden = true;
			elNoi.hidden = false;
			elNoi.innerHTML = `<button class="tt-quay" type="button" data-tt-quay>← Danh sách bài</button>
				<header class="tt-dau">
					<h2>${b.so}. ${esc(b.ten)}</h2>
					<p class="tt-dau-nhan">${esc(DANG[b.dang])} · ${nhanMuc(b.muc)} · ${esc(b.phuc_tap)}</p>
				</header>
				<div class="tt-tach">
					<div class="tt-de">
						<p class="tt-mota">${esc(b.de)}</p>
						<h3>Ví dụ</h3>
						${b.vi_du.map((v) => `<div class="tt-vd"><p><strong>Vào:</strong> <code>${esc(v.vao)}</code></p><p><strong>Ra:</strong> <code>${esc(v.ra)}</code></p></div>`).join('')}
						<h3>Ràng buộc</h3>
						<ul>${b.rang_buoc.map((x) => `<li>${esc(x)}</li>`).join('')}</ul>
						<p class="tt-link"><a href="${esc(b.tuong_tu.link)}" target="_blank" rel="noopener">Dạng tương tự trên LeetCode: ${esc(b.tuong_tu.ten)} ↗</a></p>
					</div>
					<div class="tt-code">
						<label class="tt-nhan-code" for="tt-nhap">Code Python</label>
						<textarea id="tt-nhap" class="tt-nhap" rows="16" spellcheck="false">${esc(nhap)}</textarea>
						<div class="tt-nut">
							<button class="tt-chay" type="button" data-tt-chay>▶ Chạy ví dụ</button>
							<button class="tt-nop" type="button" data-tt-nop>Nộp (test ẩn)</button>
							<button class="tt-ai" type="button" data-tt-ai>Hỏi trợ lý</button>
						</div>
						<pre class="tt-kq" data-tt-kq aria-live="polite"></pre>
						<div class="tt-goiy">
							<p class="tt-goiy-nhan">Gợi ý theo nấc</p>
							<div class="tt-goiy-nut">
								${b.goi_y.map((_, i) => `<button type="button" data-tt-goiy="${i}">Gợi ý ${i + 1}</button>`).join('')}
							</div>
							<div data-tt-goiy-noi class="tt-goiy-noi"></div>
						</div>
						<div class="tt-troly" data-tt-troly></div>
						<div class="tt-loi-giai" data-tt-loi-giai ${b.so && docTT().daGiai[b.so] ? '' : 'hidden'}>
							<h3>Lời giải mẫu</h3>
							<pre>${esc(b.loi_giai)}</pre>
							${b.vi_sao_dung ? `<h3>Vì sao đúng</h3><p class="tt-chung-minh">${esc(b.vi_sao_dung)}</p>` : ''}
							<p class="tt-phuc-tap">Độ phức tạp: ${esc(b.phuc_tap)}${b.do_phuc_tap_chat && b.do_phuc_tap_chat !== b.phuc_tap ? ` · chặt: ${esc(b.do_phuc_tap_chat)}` : ''}</p>
						</div>
						<button class="tt-chiu" type="button" data-tt-chiu>Chịu thua, xem lời giải</button>
					</div>
				</div>`;
			window.scrollTo({ top: 0, behavior: 'smooth' });
		};

		elDs.addEventListener('click', (e) => {
			const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tt-mo]');
			if (b) moBai(Number(b.dataset.ttMo));
		});

		let henNhap: number | undefined;
		elNoi.addEventListener('input', (e) => {
			const ta = (e.target as HTMLElement).closest<HTMLTextAreaElement>('.tt-nhap');
			if (!ta) return;
			const so = Number((elNoi.querySelector('.tt-dau h2')?.textContent ?? '0').split('.')[0]);
			window.clearTimeout(henNhap);
			henNhap = window.setTimeout(() => luuNhap(so, ta.value), 400);
		});

		elNoi.addEventListener('click', async (e) => {
			const t = e.target as HTMLElement;
			if (t.closest('[data-tt-quay]')) {
				elNoi.hidden = true;
				elDs.hidden = false;
				veDanhSach();
				return;
			}
			if (t.closest('[data-tt-chiu]')) {
				elNoi.querySelector<HTMLElement>('[data-tt-loi-giai]')!.hidden = false;
				(elNoi.querySelector('[data-tt-chiu]') as HTMLButtonElement).hidden = true;
				return;
			}
			const nutGoiY = t.closest<HTMLButtonElement>('[data-tt-goiy]');
			if (nutGoiY) {
				const so = Number((elNoi.querySelector('.tt-dau h2')?.textContent ?? '0').split('.')[0]);
				const b = BAI.find((x) => x.so === so);
				if (!b) return;
				const i = Number(nutGoiY.dataset.ttGoiy);
				const noi = elNoi.querySelector<HTMLElement>('[data-tt-goiy-noi]')!;
				noi.textContent = b.goi_y.slice(0, i + 1).map((x, j) => `Nấc ${j + 1}: ${x}`).join('\n\n');
				return;
			}
			if (t.closest('[data-tt-ai]')) {
				const so = Number((elNoi.querySelector('.tt-dau h2')?.textContent ?? '0').split('.')[0]);
				const b = BAI.find((x) => x.so === so);
				if (!b) return;
				const ma = (elNoi.querySelector('.tt-nhap') as HTMLTextAreaElement).value;
				const o = elNoi.querySelector<HTMLElement>('[data-tt-troly]')!;
				o.innerHTML = '<p class="tt-dang">Đang hỏi trợ lý...</p>';
				const kq = await hoiTroLy({
					messages: [
						{
							role: 'user',
							content: `Bài tập: ${b.de}\n\nCode hiện tại:\n\`\`\`python\n${ma}\n\`\`\`\n\nHãy gợi ý hướng nghĩ và cấu trúc dữ liệu phù hợp. Tuyệt đối không đưa code lời giải hoàn chỉnh; kết thúc bằng một câu hỏi để tôi tự nghĩ tiếp.`,
						},
					],
					context: { trang: location.pathname, tieuDe: b.ten },
				});
				if (kq.text) o.innerHTML = await thanhHtml(kq.text);
				else o.textContent = [kq.thongBao, `Gợi ý cục bộ: ${b.goi_y[0]}`].filter(Boolean).join('\n\n');
				return;
			}
			const laNop = !!t.closest('[data-tt-nop]');
			if (!laNop && !t.closest('[data-tt-chay]')) return;
			const so = Number((elNoi.querySelector('.tt-dau h2')?.textContent ?? '0').split('.')[0]);
			const b = BAI.find((x) => x.so === so);
			if (!b) return;
			const ma = (elNoi.querySelector('.tt-nhap') as HTMLTextAreaElement).value;
			const o = elNoi.querySelector<HTMLElement>('[data-tt-kq]')!;
			const nutNop = elNoi.querySelector<HTMLButtonElement>('[data-tt-nop]')!;
			const nutChay = elNoi.querySelector<HTMLButtonElement>('[data-tt-chay]')!;
			o.textContent = 'Đang chạy...';
			nutNop.disabled = nutChay.disabled = true;
			luuNhap(so, ma);
			const kq = await chayCode(ma, laNop ? b.test_an : b.test_vi_du);
			nutNop.disabled = nutChay.disabled = false;
			if (kq.dat) {
				o.textContent = `✔ Đạt${laNop ? ' toàn bộ test ẩn' : ' ví dụ'}.\n${kq.out}`.trim();
				o.className = 'tt-kq dat';
				elNoi.querySelector<HTMLElement>('[data-tt-loi-giai]')!.hidden = false;
				(elNoi.querySelector('[data-tt-chiu]') as HTMLButtonElement).hidden = true;
				if (laNop) {
					const tt = docTT();
					if (!tt.daGiai[so]) {
						const homNay = ngayDiaPhuong(new Date());
						tt.daGiai[so] = homNay;
						if (!tt.ngay.includes(homNay)) tt.ngay.push(homNay);
						ghiTT(tt);
					}
				}
			} else {
				const tt = docTT();
				if (laNop) {
					tt.daThu[so] = (tt.daThu[so] ?? 0) + 1;
					ghiTT(tt);
				}
				o.textContent = `Chưa đạt.${kq.loi ? `\n${kq.loi}` : ''}${kq.out ? `\n${kq.out}` : ''}`;
				o.className = 'tt-kq chua';
			}
		});

		// Code người học được esc trước khi đưa vào textarea nên không phá được trang.
		elTong.addEventListener('click', (e) => {
			const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tt-cd]');
			if (!b) return;
			cheDo = b.dataset.ttCd === 'lo-trinh' ? 'lo-trinh' : 'dang';
			veDanhSach();
		});
		veDanhSach();
	}
</script>

<style is:global>
	.tt {
		font-family: 'Be Vietnam Pro', system-ui, sans-serif;
	}
	.tt-ds[hidden],
	.tt-noi[hidden],
	.tt-loi-giai[hidden] {
		display: none;
	}
	.tt-tong {
		margin: 0.6rem 0 1rem;
		padding: 0.8rem 1rem;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: var(--panel);
	}
	.tt-tong-chu {
		margin: 0;
		font-size: 0.95rem;
	}
	.tt-tong-chu strong {
		font-size: 1.5rem;
		color: var(--pri);
	}
	.tt-tong-chu span {
		color: var(--mut-chu);
		font-size: 0.85rem;
	}
	.tt-tong-mo {
		margin: 0.2rem 0 0;
		font-size: 0.82rem;
		color: var(--mut-chu);
	}
	.tt-che-do {
		display: flex;
		gap: 0.3rem;
		margin-top: 0.55rem;
	}
	.tt-che-do button {
		padding: 0.25rem 0.65rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--bg);
		color: var(--mut-chu);
		font: 600 0.78rem 'Be Vietnam Pro', sans-serif;
		cursor: pointer;
	}
	.tt-che-do button.dang-chon {
		border-color: var(--pri);
		color: var(--pri);
		background: var(--accbg);
	}
	.tt-buoc {
		flex: none;
		font-size: 0.66rem;
		font-weight: 700;
		color: var(--mut-chu);
		letter-spacing: 0.02em;
	}
	.tt-lo-trinh-mo {
		margin: 0 0 0.5rem;
		font-size: 0.82rem;
		color: var(--mut-chu);
	}
	.tt-nhom h3 {
		margin: 1.4rem 0 0.5rem;
		font-size: 1rem;
	}
	.tt-nhom h3 span {
		font-weight: 400;
		color: var(--mut-chu);
		font-size: 0.82rem;
	}
	.tt-luoi {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
		gap: 0.5rem;
	}
	.tt-the {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		padding: 0.55rem 0.7rem;
		border: 1px solid var(--line);
		border-radius: 9px;
		background: var(--bg);
		color: var(--tx);
		font: 0.88rem 'Be Vietnam Pro', sans-serif;
		text-align: left;
		cursor: pointer;
	}
	.tt-the:hover {
		border-color: var(--pri);
	}
	.tt-the.da-giai {
		border-color: var(--ok);
		background: color-mix(in srgb, var(--ok) 8%, var(--bg));
	}
	.tt-so {
		flex: none;
		font-family: 'JetBrains Mono', monospace;
		font-weight: 700;
		color: var(--pri);
		font-size: 0.78rem;
	}
	.tt-ten {
		flex: 1;
		min-width: 0;
	}
	.tt-muc {
		flex: none;
		padding: 0.05rem 0.45rem;
		border-radius: 999px;
		font-size: 0.68rem;
		font-weight: 600;
	}
	.tt-m-de {
		background: color-mix(in srgb, var(--ok) 15%, transparent);
		color: var(--ok-chu);
	}
	.tt-m-vua {
		background: var(--accbg);
		color: var(--acc-chu);
	}
	.tt-m-kho {
		background: color-mix(in srgb, var(--red) 14%, transparent);
		color: var(--red-chu);
	}
	.tt-xong {
		color: var(--ok-chu);
		font-weight: 800;
	}
	.tt-quay {
		margin-top: 0.4rem;
		padding: 0.35rem 0.7rem;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--bg);
		color: var(--pri);
		font: 600 0.82rem 'Be Vietnam Pro', sans-serif;
		cursor: pointer;
	}
	.tt-dau h2 {
		margin: 0.7rem 0 0.2rem;
		font-size: 1.4rem;
	}
	.tt-dau-nhan {
		margin: 0 0 1rem;
		font-size: 0.82rem;
		color: var(--mut-chu);
	}
	.tt-tach {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 1.2rem;
		align-items: start;
	}
	.tt-de h3 {
		margin: 1rem 0 0.4rem;
		font-size: 0.95rem;
	}
	.tt-mota {
		line-height: 1.65;
		white-space: pre-wrap;
	}
	.tt-vd {
		margin: 0.4rem 0;
		padding: 0.45rem 0.65rem;
		border-left: 3px solid var(--line);
		background: var(--panel);
		font-size: 0.85rem;
	}
	.tt-vd p {

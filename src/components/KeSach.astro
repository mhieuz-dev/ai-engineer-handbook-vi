---
import { dsCuonSach } from '../lib/ke-sach/du-lieu';

const sach = dsCuonSach();
const nhanThe = (i: number, sapCo: boolean) => `Nhánh ${i + 1}${sapCo ? '' : ' · Đang viết'}`;
const moTaThe = (s: (typeof sach)[number]) => (s.sapCo ? 'Sắp có' : `${s.tongChuong} chương · đã viết ${s.daViet}`);
---

<section id="ke-sach" class="ke-sach" aria-labelledby="ke-sach-tieu-de" data-ds={JSON.stringify(sach)}>
	<div class="khung">
		<div class="thanh">
			<h2 id="ke-sach-tieu-de">Kệ sách</h2>
			<p class="goi-y">Chọn một cuốn để đọc<span class="chi-3d"> · Kéo để xoay kệ</span></p>
		</div>
		<div class="san-khau" data-frames="0" data-trang-thai="phang">
			<div class="ke-phang" aria-hidden="true">
				<div class="hang-bia">
					{
						sach.map((s) => {
							const noiDung = (
								<Fragment>
									{s.anhBiaNho && <img class="anh-bia" src={s.anhBiaNho} alt="" width="360" height="540" loading="lazy" decoding="async" fetchpriority="low" />}
									<span class="bia-nhan">AI &amp; ROBOTICS</span>
									<span class="bia-ten">{s.ten.toUpperCase().split(' ').map((t) => <span>{t}</span>)}</span>
									<span class="bia-phu">{s.phuDe}</span>
									{s.sapCo && <span class="bia-dai">Sắp có</span>}
								</Fragment>
							);
							return s.href ? (
								<a class={`bia-phang bia-${s.id}`} data-cuon={s.id} href={s.href} tabindex="-1">
									{noiDung}
								</a>
							) : (
								<div class={`bia-phang bia-${s.id}`} data-cuon={s.id}>
									{noiDung}
								</div>
							);
						})
					}
				</div>
				<div class="van-ke"></div>
			</div>
			<div class="bang" id="ke-sach-bang" role="dialog" aria-labelledby="bang-ten" hidden>
				<p class="bang-nhan">Nhánh đã chọn</p>
				<h3 id="bang-ten" class="bang-ten"></h3>
				<p class="bang-mo-ta"></p>
				<p class="bang-so"></p>
				<div class="bang-nut">
					<a class="bang-bat-dau" href="#ke-sach">Bắt đầu học</a>
					<button type="button" class="bang-quay-lai">← Quay lại kệ sách</button>
				</div>
			</div>
		</div>
		<div class="hang-the">
			{
				sach.map((s, i) =>
					s.href ? (
						<a class="the-chon" data-cuon={s.id} href={s.href}>
							<span class="the-nhan">{nhanThe(i, s.sapCo)}</span>
							<strong class="the-ten">{s.ten}</strong>
							<span class="the-mo-ta">{moTaThe(s)}</span>
						</a>
					) : (
						<button type="button" class="the-chon the-sap-co" data-cuon={s.id}>
							<span class="the-nhan">{nhanThe(i, s.sapCo)}</span>
							<strong class="the-ten">{s.ten}</strong>
							<span class="the-mo-ta">{moTaThe(s)}</span>
						</button>
					),
				)
			}
		</div>
	</div>
</section>

<script>
	import type { CuonSach } from '../lib/ke-sach/du-lieu';
	import type { KeSach3D } from '../lib/ke-sach/canh-3d';
	import { du3D, RONG_3D } from '../lib/ke-sach/cong-3d';

	const goc = document.getElementById('ke-sach');
	if (goc) {
		const sanKhau = goc.querySelector<HTMLElement>('.san-khau')!;
		const bang = goc.querySelector<HTMLElement>('.bang')!;
		const nutBatDau = bang.querySelector<HTMLAnchorElement>('.bang-bat-dau')!;
		const nutQuayLai = bang.querySelector<HTMLButtonElement>('.bang-quay-lai')!;
		const sach: CuonSach[] = JSON.parse(goc.dataset.ds ?? '[]');
		let ke: KeSach3D | null = null;
		let nguoiMo: HTMLElement | null = null;
		let khoiPhuc = false;

		const moBang = (s: CuonSach, opener: HTMLElement | null) => {
			nguoiMo = opener;
			bang.querySelector('.bang-ten')!.textContent = s.ten;
			bang.querySelector('.bang-mo-ta')!.textContent = s.moTa;
			bang.querySelector('.bang-so')!.textContent = s.sapCo ? 'Sắp có' : `${s.tongChuong} chương · đã viết ${s.daViet}`;
			nutBatDau.hidden = !s.href;
			if (s.href) nutBatDau.href = s.href;
			bang.hidden = false;
			goc.dataset.sachMo = s.id;
			(s.href ? nutBatDau : nutQuayLai).focus({ preventScroll: true });
		};
		const dongBang = () => {
			if (bang.hidden) return;
			bang.hidden = true;
			delete goc.dataset.sachMo;
			ke?.dong();
			// Trả focus bằng code: không làm cuốn sách nhích ra như khi người dùng tab tới.
			khoiPhuc = true;
			nguoiMo?.focus({ preventScroll: true });
			khoiPhuc = false;
			nguoiMo = null;
		};
		const khiChon = (s: CuonSach) => moBang(s, goc.querySelector<HTMLElement>(`.the-chon[data-cuon="${s.id}"]`));
		nutQuayLai.addEventListener('click', dongBang);
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !e.defaultPrevented && !bang.hidden && !document.querySelector('dialog[open]')) dongBang();
		});

		const nguoiMoId = () => (bang.hidden ? null : nguoiMo?.dataset.cuon);
		goc.addEventListener('click', (e) => {
			const el = (e.target as HTMLElement).closest<HTMLElement>('[data-cuon]');
			if (!el || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
			const s = sach.find((x) => x.id === el.dataset.cuon);
			if (!s) return;
			// Không chuyển trang: mở bảng thông tin; cảnh 3D (nếu có) rút cuốn sách ra và mở bìa.
			e.preventDefault();
			ke?.chon(s.id);
			if (s.id !== nguoiMoId()) khiChon(s);
		});
		for (const loai of ['pointerover', 'focusin'] as const) {
			goc.addEventListener(loai, (e) => {
				const el = (e.target as HTMLElement).closest<HTMLElement>('.the-chon');
				if (el && !khoiPhuc) ke?.danhDau(el.dataset.cuon as CuonSach['id']);
			});
		}
		for (const loai of ['pointerout', 'focusout'] as const) {
			goc.addEventListener(loai, (e) => {
				if ((e.target as HTMLElement).closest('.the-chon')) ke?.danhDau(null);
			});
		}

		// Chỉ máy tính (≥ 820px, có chuột) không yêu cầu giảm chuyển động và có WebGL2 mới tải three;
		// điện thoại và máy tính bảng cảm ứng giữ bản phẳng.
		const coWebGL = () => {
			try {
				const gl = document.createElement('canvas').getContext('webgl2');
				gl?.getExtension('WEBGL_lose_context')?.loseContext();
				return !!gl;
			} catch {
				return false;
			}
		};
		const mqRong = matchMedia(`(min-width: ${RONG_3D}px)`);
		const mqGiam = matchMedia('(prefers-reduced-motion: reduce)');
		const mqTro = matchMedia('(pointer: fine)');
		const dieuKien = (webgl: boolean | (() => boolean)) =>
			du3D({ rong: mqRong.matches ? RONG_3D : 0, giamChuyenDong: mqGiam.matches, troChinhXac: mqTro.matches, webgl });

		if ('IntersectionObserver' in window) {
			let dangTai = false;
			const batDau = async () => {
				// Kiểm WebGL2 lúc kệ sắp hiện, không làm chậm lần tải đầu; không có thì giữ bản phẳng, không tải three.
				if (ke || dangTai || !dieuKien(coWebGL)) return;
				dangTai = true;
				const { dungKe } = await import('../lib/ke-sach/canh-3d');
				dangTai = false;
				// Điều kiện có thể đã đổi trong lúc tải chunk.
				if (!ke && dieuKien(true)) {
					ke = dungKe(sanKhau, sach, khiChon);
					// Bảng đang mở trước khi cảnh dựng xong: rút cuốn tương ứng ra cho khớp.
					const dangMoId = nguoiMoId();
					if (dangMoId) ke.chon(dangMoId as CuonSach['id']);
				}
			};
			const io = new IntersectionObserver(
				(e) => {
					if (!e.some((x) => x.isIntersecting)) return;
					io.disconnect();
					batDau();
				},
				{ rootMargin: '200px' },
			);
			// Chờ kệ tới gần màn hình nếu đủ điều kiện; hết đủ điều kiện (thu cửa sổ, bật giảm chuyển động,
			// đổi sang cảm ứng) thì gỡ cảnh 3D, về kệ phẳng.
			const capNhat = () => {
				if (dieuKien(true)) {
					if (!ke) io.observe(goc);
					return;
				}
				io.disconnect();
				ke?.huy();
				ke = null;
			};
			for (const mq of [mqRong, mqGiam, mqTro]) mq.addEventListener('change', capNhat);
			capNhat();
			// Rời trang thì giải phóng GPU; quay lại bằng nút Back (bfcache) thì dựng lại khi kệ trong tầm nhìn.
			addEventListener('pagehide', () => {
				io.disconnect();
				ke?.huy();
				ke = null;
			});
			addEventListener('pageshow', (e) => {
				if (e.persisted) capNhat();
			});
		}
	}
</script>

<style>
	.ke-sach { margin: 2.2rem 0 2.5rem; }
	.khung {
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--panel);
		overflow: hidden;
		box-shadow: 0 1px 0 rgba(255, 255, 255, 0.6) inset, 0 18px 40px -28px rgba(60, 40, 20, 0.35);
	}
	.thanh { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 0.75rem 1.1rem; border-bottom: 1px solid var(--line); }
	.thanh h2 { margin: 0; font-size: 0.82rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--tx); border: 0; }
	.goi-y { margin: 0; font-size: 0.8rem; color: var(--mut); }
	.chi-3d { display: none; }
	.ke-sach:has(.san-khau[data-trang-thai='san-sang']) .chi-3d { display: inline; }

	/* Sân khấu: "bức tường" sau kệ, tối dần về mép như có đèn rọi. */
	.san-khau {
		position: relative;
		--tuong-1: #f7f0e3;
		--tuong-2: #e4d6bd;
		background: radial-gradient(ellipse 70% 85% at 50% 38%, var(--tuong-1), var(--tuong-2) 78%, #d6c4a5);
		padding: 1.6rem 1rem 1.2rem;
	}
	:global([data-theme='dark']) .san-khau {
		--tuong-1: #2c2620;
		--tuong-2: #1a1714;
		background: radial-gradient(ellipse 70% 85% at 50% 38%, var(--tuong-1), var(--tuong-2) 78%, #121010);
	}
	.san-khau :global(canvas.canvas-3d) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: pan-y; animation: hien 0.35s ease-out; }
	@keyframes hien { from { opacity: 0; } to { opacity: 1; } }
	.san-khau[data-trang-thai='san-sang'] .ke-phang { visibility: hidden; }

	/* Bản phẳng: hai bìa CSS đứng trên một tấm ván. Cỡ chữ theo bề rộng bìa (cqw) để bìa nào cũng cân. */
	.ke-phang { max-width: 30rem; margin: 0 auto; }
	.hang-bia { display: flex; justify-content: center; align-items: flex-end; gap: 7%; padding: 0 6%; }
	.bia-phang {
		position: relative;
		flex: 0 1 42%;
		container-type: inline-size;
		aspect-ratio: 2 / 3;
		border-radius: 2px 5px 5px 2px;
		overflow: hidden;
		text-decoration: none;
		font-family: 'Be Vietnam Pro', system-ui, sans-serif;
		box-shadow: inset 5px 0 0 rgba(0, 0, 0, 0.22), inset 6px 0 0 rgba(255, 255, 255, 0.1), 6px 8px 14px -6px rgba(40, 25, 10, 0.55);
	}
	.anh-bia { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
	.anh-bia ~ span { display: none; }
	.bia-nhan { position: absolute; top: 9cqw; left: 11cqw; font-size: 3.6cqw; font-weight: 600; letter-spacing: 0.14em; opacity: 0.75; white-space: nowrap; }
	.bia-ten { position: absolute; left: 11cqw; bottom: 25cqw; font-weight: 800; line-height: 1; }
	.bia-ten span { display: block; }
	.bia-phu { position: absolute; left: 11cqw; right: 8cqw; bottom: 9cqw; font-size: 4.4cqw; line-height: 1.35; opacity: 0.85; }
	.bia-ai-engineer {
		color: #fff;
		background:
			radial-gradient(circle at 60% 30%, rgba(150, 210, 255, 0.9) 0 1.5px, transparent 2.5px),
			radial-gradient(circle at 46% 22%, rgba(150, 210, 255, 0.8) 0 1px, transparent 2px),
			radial-gradient(circle at 74% 40%, rgba(150, 210, 255, 0.8) 0 1px, transparent 2px),
			radial-gradient(circle at 66% 18%, rgba(150, 210, 255, 0.7) 0 1px, transparent 2px),
			radial-gradient(circle at 60% 30%, rgba(70, 160, 255, 0.45), rgba(40, 110, 210, 0.12) 34%, transparent 55%),
			linear-gradient(135deg, #0b1a29, #0e2233);
	}
	.bia-ai-engineer .bia-nhan { color: #a0d2ff; }
	.bia-ai-engineer .bia-ten { font-size: 11.5cqw; color: #8ec9ff; letter-spacing: 0.03em; }
	.bia-ai-engineer .bia-ten span:first-child { font-size: 25cqw; color: #fff; }
	.bia-ai-engineer .bia-ten::before { content: ''; display: block; width: 11cqw; height: 1.2cqw; min-height: 2px; background: #e07a1f; margin-bottom: 3cqw; }
	.bia-robotics { color: #1f2a33; background: radial-gradient(circle at 66% 40%, #fff, transparent 60%), linear-gradient(160deg, #eef0f2, #c9ced3); }
	.bia-robotics .bia-ten { left: 5cqw; bottom: 9cqw; writing-mode: vertical-rl; transform: rotate(180deg); font-size: 20cqw; letter-spacing: 0.03em; }
	.bia-robotics .bia-nhan, .bia-robotics .bia-phu { left: 34cqw; color: #4a5560; }
	.bia-robotics .bia-nhan { white-space: normal; }
	.bia-dai { position: absolute; top: 9cqw; right: -15cqw; transform: rotate(45deg); background: #e07a1f; color: #fff; font-size: 4cqw; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; padding: 1.2cqw 18cqw; }
	.van-ke {
		height: 14px;
		margin-top: -1px;
		border-radius: 3px;
		background: repeating-linear-gradient(90deg, rgba(0, 0, 0, 0) 0 37px, rgba(40, 20, 8, 0.08) 37px 39px), linear-gradient(#93623b, #6e4527);
		box-shadow: 0 10px 16px -8px rgba(40, 25, 10, 0.55);
	}

	/* Thẻ chọn: điều khiển thật, dùng được bằng bàn phím. */
	.hang-the { display: grid; gap: 0.5rem; padding: 0.8rem; border-top: 1px solid var(--line); }
	.the-chon {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: baseline;
		column-gap: 0.8rem;
		padding: 0.55rem 0.8rem;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--bg);
		color: var(--tx);
		font: inherit;
		text-align: left;
		text-decoration: none;
		cursor: pointer;
		transition: border-color 0.15s, transform 0.15s;
	}
	.the-chon:hover { border-color: var(--pri); transform: translateY(-1px); }
	.the-chon:focus-visible { outline: 2px solid var(--pri); outline-offset: 2px; }
	.the-nhan { grid-column: 1 / -1; font-size: 0.75rem; color: var(--mut); }
	.the-ten { font-size: 1rem; font-weight: 700; color: var(--tx); }
	.the-mo-ta { font-size: 0.82rem; color: var(--pri); white-space: nowrap; }
	.the-sap-co .the-mo-ta { color: var(--acc); }

	/* Bảng thông tin: hiện sau khi chọn sách. Điện thoại nằm dưới kệ; từ 50rem nổi bên phải sân khấu. */
	.bang { margin: 0.9rem 0 0; padding: 1rem 1.1rem; border: 1px solid var(--line); border-radius: 12px; background: var(--bg); color: var(--tx); box-shadow: 0 14px 30px -18px rgba(40, 25, 10, 0.5); animation: bang-vao 0.28s ease-out; }
	.bang[hidden] { display: none; }
	@keyframes bang-vao { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
	.bang-nhan { margin: 0; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mut); }
	.bang-ten { margin: 0.2rem 0 0.4rem; font-size: 1.5rem; font-weight: 800; line-height: 1.2; border: 0; color: var(--tx); }
	.bang-mo-ta { margin: 0 0 0.6rem; font-size: 0.95rem; line-height: 1.55; color: var(--tx); }
	.bang-so { display: inline-block; margin: 0 0 1rem; padding: 0.15rem 0.6rem; border-radius: 99px; background: var(--accbg); color: var(--tx); font-size: 0.82rem; font-weight: 600; }
	.bang-nut { display: flex; flex-wrap: wrap; gap: 0.6rem; }
	.bang-bat-dau, .bang-quay-lai { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 1.2rem; border-radius: 8px; font: inherit; font-weight: 600; text-decoration: none; cursor: pointer; }
	.bang-bat-dau { background: var(--acc); color: #1a1208; border: 1px solid transparent; }
	.bang-bat-dau:hover { filter: brightness(1.08); }
	.bang-bat-dau[hidden] { display: none; }
	.bang-quay-lai { background: transparent; color: var(--tx); border: 1px solid var(--line); }
	.bang-quay-lai:hover { border-color: var(--pri); }
	.bang-bat-dau:focus-visible, .bang-quay-lai:focus-visible { outline: 2px solid var(--pri); outline-offset: 2px; }

	@media (min-width: 50rem) {
		/* Giữ đúng chiều cao cho cả bản phẳng lẫn canvas để không nhảy bố cục khi 3D hiện. */
		.san-khau { aspect-ratio: 16 / 9; padding: 0; display: flex; align-items: center; }
		.ke-phang { width: 40%; max-width: none; }
		.bang { position: absolute; z-index: 2; top: 50%; right: 4%; width: min(21rem, 38%); margin: 0; transform: translateY(-50%); animation-name: bang-vao-ngang; }
		@keyframes bang-vao-ngang { from { opacity: 0; transform: translate(12px, -50%); } to { opacity: 1; transform: translateY(-50%); } }
		.hang-the { display: flex; justify-content: center; gap: 0.75rem; }
		.the-chon { display: flex; flex-direction: column; align-items: flex-start; gap: 0.1rem; min-width: 13rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.bang { animation: none; }
		.the-chon { transition: none; }
		.the-chon:hover { transform: none; }
	}
</style>
